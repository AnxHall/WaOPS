{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future WaOPS Plugin Manifest v1",
  "type": "object",
  "required": ["id", "version", "name", "capabilities"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string"},
    "name": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {"type": "string"}
    },
    "events": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
